{
  "name": "@diametral/design-system",
  "version": "1.0.0-beta.1",
  "description": "Diametral Design System — a minimal, flat, buildless CSS + tokens + Web Components design system. Welcome to (the real).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "web-components",
    "diametral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBigCode/design-system.git"
  },
  "homepage": "https://littlebigcode.github.io/design-system/",
  "publishConfig": {
    "access": "public",
    "exports": {
      "./probe": "./dist/probe.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "./components/*.js",
    "./dist/components/*.js"
  ],
  "files": [
    "css",
    "components",
    "tokens",
    "dist",
    "docs",
    "configs",
    "emails",
    "keycloak",
    "assets/fonts/ufficio.css",
    "assets/fonts/fallback.css",
    "assets/fonts/LICENSE-FONTS.md",
    "assets/logo/diametral-mark.svg",
    "assets/logo/diametral-mark-light.svg",
    "assets/logo/favicon.svg",
    "assets/logo/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "style": "./css/diametral.css",
      "default": "./css/diametral.css"
    },
    "./css/diametral.css": "./css/diametral.css",
    "./css/*": "./css/*",
    "./tokens.json": "./tokens/tokens.json",
    "./components": "./components/index.js",
    "./components/*": "./components/*",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./configs/*": "./configs/*",
    "./emails": {
      "types": "./emails/diametral-email.d.ts",
      "default": "./emails/diametral-email.js"
    },
    "./tailwind-preset": "./dist/tailwind-preset.cjs",
    "./dist/*": "./dist/*",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "npm run build:react && node scripts/build-tokens.mjs && node scripts/build-css.mjs && node scripts/build-components.mjs && node scripts/build-figma.mjs && node scripts/build-migration-guide.mjs && node scripts/build-components-md.mjs",
    "build:react": "tsc -p tsconfig.build.json",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:figma": "node scripts/build-figma.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:components": "node scripts/build-components.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && node scripts/check-contracts.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "serve": "python3 -m http.server 8080",
    "test:visual": "playwright test tests/visual.spec.js",
    "test:visual:update": "playwright test tests/visual.spec.js --update-snapshots",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "build:components-md": "node scripts/build-components-md.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "~5.7"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10"
  }
}
