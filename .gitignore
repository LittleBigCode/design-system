# Generated convenience build (run `npm run build` to produce). The hand-authored
# css/ and components/ work with no build, so dist/ is not committed.
dist/

# Docs generator output (scripts/build-docs.mjs). Only switch.html exists so far
# (issue #30, the tracer bullet) — this list grows slug by slug until the rest
# of examples/components/ is generator-owned too, at which point this narrows
# to the other direction (hand-authored pages listed instead).
examples/components/switch.html

# Dependencies (the system itself has none)
node_modules/
pnpm-lock.yaml

# OS / editor
.DS_Store
*.log

# Internal build-agent contract (not part of the published system)
AGENT_CONTRACT.md

# Playwright visual regression test output (baselines in tests/__screenshots__/
# ARE committed; these directories are generated artifacts and are not).
test-results/
playwright-report/
/.playwright
